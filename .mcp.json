{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--allow-unrestricted-file-access",
        "--output-dir",
        ".playwright-mcp"
      ],
      "env": {}
    }
  }
}
