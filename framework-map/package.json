{
  "name": "framework-map",
  "private": true,
  "version": "0.0.0",
  "description": "The map: an interactive 3D presentation of the Hermes OS tool framework, built as one self-contained HTML file.",
  "type": "module",
  "scripts": {
    "dev": "vite --open /framework-map.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python -m unittest discover ../tool-discovery",
    "validate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/validate-graph.ts",
    "generate": "python ../tool-discovery/generate_graph.py && npm run validate",
    "build": "tsc --noEmit && npm run validate && vite build && node scripts/publish.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22.20.5",
    "playwright": "^1.65.1",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
